# Copy this file to .env and fill in your values before running docker compose up -d
# Keep comments on their own lines — do not put comments after values.

# ---- COLLABORA ----
# Nextcloud domain that Collabora is allowed to serve documents for.
# Dots must be escaped with double backslash.
COLLABORA_DOMAIN=cloud\\.yourdomain\\.com

# Collabora admin console credentials
COLLABORA_USERNAME=admin
COLLABORA_PASSWORD=CHANGE_ME_ADMIN123$

# Runtime flags — ssl handled by reverse proxy (termination=true, enable=false)
COLLABORA_EXTRA_PARAMS=--o:ssl.enable=false --o:ssl.termination=true --o:welcome.enable=false --o:net.proxy_prefix=true

# Public hostname of your Collabora server (used in WOPI requests)
COLLABORA_SERVER_NAME=office.yourdomain.com
